# Anthropic (Claude) API
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-5

# Which WhatsApp number(s) are allowed to use the agent.
# Comma-separated list of full WhatsApp JIDs, e.g. "972501234567@c.us".
# Leave empty to allow only your own linked account (messages you send to yourself),
# which is the safest default for a personal assistant.
ALLOWED_SENDERS=

# Excel data file (created automatically on first run if missing)
EXCEL_FILE_PATH=./data/workbook.xlsx

# Google Calendar OAuth2 (Desktop app credentials from Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
# GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Populated automatically by `npm run google-auth` (see README) - do not commit
GOOGLE_TOKEN_PATH=./data/google-token.json
GOOGLE_CALENDAR_ID=4d72237704a77a11e4de6e3bf3250ad4b10ad26f22f34e29d8c98c5f17e74f5a@group.calendar.google.com

# IANA timezone used when creating/reading calendar events
TIMEZONE=Asia/Jerusalem

# Server
PORT=3000
